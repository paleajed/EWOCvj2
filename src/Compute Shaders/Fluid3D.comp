// Fluid3D: all fields are float arrays (SSBOs) on an N^3 grid.
//   vel/vel2 : 4 floats per cell (x,y,z, unused)       dye/dye2 : 2 floats per cell (smoke density, temperature)
//   prs/prs2 : 2 floats per cell (pressure, unused)    dye2 doubles as scratch for the curl magnitude / divergence
// A frame is: forces -> vorticity confinement -> advect velocity -> project -> advect dye -> render.
// The vorticity vector is kept implicitly: "curl" stores |curl| in dye2.x, "vortf" re-derives curl from vel.
// Pressure sweeps alternate prs->prs2 and prs2->prs inside one REPEATed pass (2*iters sweeps).

const float PI = 3.14159265359;

#ifdef BIND_vel
layout(std430, binding = BIND_vel) buffer VelBuf { float velv[]; };
#endif
#ifdef BIND_vel2
layout(std430, binding = BIND_vel2) buffer Vel2Buf { float vel2v[]; };
#endif
#ifdef BIND_dye
layout(std430, binding = BIND_dye) buffer DyeBuf { float dyev[]; };
#endif
#ifdef BIND_dye2
layout(std430, binding = BIND_dye2) buffer Dye2Buf { float dye2v[]; };
#endif
#ifdef BIND_prs
layout(std430, binding = BIND_prs) buffer PrsBuf { float prsv[]; };
#endif
#ifdef BIND_prs2
layout(std430, binding = BIND_prs2) buffer Prs2Buf { float prs2v[]; };
#endif

int N3() { return gridn * gridn * gridn; }
int cid(ivec3 c) {
    int N = gridn;
    c = clamp(c, ivec3(0), ivec3(N - 1));
    return (c.z * N + c.y) * N + c.x;
}
ivec3 cell3(int idx) { int N = gridn; return ivec3(idx % N, (idx / N) % N, idx / (N * N)); }
float dt() { return min(TIMEDELTA, 0.04) * speed * 2.0; }       // simulation step (seconds)

vec3 emitterPos(int k) {
    float a = TIME * emitspeed * (0.6 + 0.23 * float(k)) + float(k) * 2.399;
    float b = TIME * emitspeed * 0.37 * (1.0 + 0.3 * float(k)) + float(k) * 1.7;
    return vec3(0.5 + 0.36 * cos(a), 0.17 + 0.07 * sin(b * 1.7), 0.5 + 0.36 * sin(a * 0.9 + float(k)));
}

#if defined(KERNEL_forces) || defined(KERNEL_advectv) || defined(KERNEL_vortf) || defined(KERNEL_curl) || defined(KERNEL_divergence) || defined(KERNEL_project) || defined(KERNEL_advectd)
vec3 getVel(ivec3 c) { int i = cid(c) * 4; return vec3(velv[i], velv[i + 1], velv[i + 2]); }
#endif

// trilinear sample of a vec3 velocity field (cell centres at integer + 0.5)
#if defined(KERNEL_advectv) || defined(KERNEL_advectd)
vec3 sampleVel(vec3 g) {
    g -= 0.5;
    ivec3 b = ivec3(floor(g));
    vec3 f = g - vec3(b);
    vec3 c00 = mix(getVel(b), getVel(b + ivec3(1, 0, 0)), f.x);
    vec3 c10 = mix(getVel(b + ivec3(0, 1, 0)), getVel(b + ivec3(1, 1, 0)), f.x);
    vec3 c01 = mix(getVel(b + ivec3(0, 0, 1)), getVel(b + ivec3(1, 0, 1)), f.x);
    vec3 c11 = mix(getVel(b + ivec3(0, 1, 1)), getVel(b + ivec3(1, 1, 1)), f.x);
    return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}
#endif

// ------------------------------------------------------------------------------------------------ kernels
#ifdef KERNEL_init
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    int n3 = N3();
    if (idx >= 4 * n3) return;
    velv[idx] = 0.0;
    vel2v[idx] = 0.0;
    if (idx < 2 * n3) { dyev[idx] = 0.0; dye2v[idx] = 0.0; prsv[idx] = 0.0; prs2v[idx] = 0.0; }
}
#endif

#ifdef KERNEL_forces
// emitters inject smoke + heat and push upward; buoyancy accelerates hot smoke; damping bleeds speed
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    int n3 = N3();
    if (idx >= n3) return;
    ivec3 c = cell3(idx);
    float Nf = float(gridn);
    vec3 p = (vec3(c) + 0.5) / Nf;
    float h = dt();
    vec3 v = getVel(c);
    float d = dyev[idx * 2];
    float T = dyev[idx * 2 + 1];

    for (int k = 0; k < emitters; k++) {
        vec3 e = emitterPos(k);
        float r = length(p - e) / emitsize;
        if (r < 1.0) {
            float w = (1.0 - r) * (1.0 - r);
            d += w * 1.6 * h * 8.0;
            T += w * 1.2 * h * 8.0;
            v.y += w * emitforce * h * 6.0;
            vec3 sw = cross(vec3(0.0, 1.0, 0.0), p - e);        // slight swirl around the plume
            v += sw * w * emitforce * h * 6.0;
        }
    }
    v.y += (buoyancy * (T - 0.0) - 0.3 * buoyancy * d) * h * 3.0;
    v *= exp(-damping * h);
    d *= exp(-dissipation * h);
    T *= exp(-(0.5 + dissipation) * h);
    dyev[idx * 2] = clamp(d, 0.0, 8.0);
    dyev[idx * 2 + 1] = clamp(T, 0.0, 4.0);

    int i = idx * 4;
    velv[i] = v.x; velv[i + 1] = v.y; velv[i + 2] = v.z;
}
#endif

#ifdef KERNEL_curl
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= N3()) return;
    ivec3 c = cell3(idx);
    vec3 vxp = getVel(c + ivec3(1, 0, 0)), vxm = getVel(c - ivec3(1, 0, 0));
    vec3 vyp = getVel(c + ivec3(0, 1, 0)), vym = getVel(c - ivec3(0, 1, 0));
    vec3 vzp = getVel(c + ivec3(0, 0, 1)), vzm = getVel(c - ivec3(0, 0, 1));
    vec3 w = 0.5 * vec3((vyp.z - vym.z) - (vzp.y - vzm.y),
                        (vzp.x - vzm.x) - (vxp.z - vxm.z),
                        (vxp.y - vxm.y) - (vyp.x - vym.x));
    dye2v[idx * 2] = length(w);
}
#endif

#ifdef KERNEL_vortf
// vorticity confinement: push along N x w where N = grad|w| / |grad|w||
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= N3()) return;
    ivec3 c = cell3(idx);
    vec3 vxp = getVel(c + ivec3(1, 0, 0)), vxm = getVel(c - ivec3(1, 0, 0));
    vec3 vyp = getVel(c + ivec3(0, 1, 0)), vym = getVel(c - ivec3(0, 1, 0));
    vec3 vzp = getVel(c + ivec3(0, 0, 1)), vzm = getVel(c - ivec3(0, 0, 1));
    vec3 w = 0.5 * vec3((vyp.z - vym.z) - (vzp.y - vzm.y),
                        (vzp.x - vzm.x) - (vxp.z - vxm.z),
                        (vxp.y - vxm.y) - (vyp.x - vym.x));
    vec3 gw = 0.5 * vec3(dye2v[cid(c + ivec3(1, 0, 0)) * 2] - dye2v[cid(c - ivec3(1, 0, 0)) * 2],
                         dye2v[cid(c + ivec3(0, 1, 0)) * 2] - dye2v[cid(c - ivec3(0, 1, 0)) * 2],
                         dye2v[cid(c + ivec3(0, 0, 1)) * 2] - dye2v[cid(c - ivec3(0, 0, 1)) * 2]);
    float glen = length(gw);
    if (glen < 1e-5) return;
    vec3 f = cross(gw / glen, w) * vorticity;
    vec3 v = getVel(c) + f * dt();
    int i = idx * 4;
    velv[i] = v.x; velv[i + 1] = v.y; velv[i + 2] = v.z;
}
#endif

#ifdef KERNEL_advectv
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= N3()) return;
    ivec3 c = cell3(idx);
    vec3 v = getVel(c);
    vec3 back = vec3(c) + 0.5 - v * dt() * float(gridn);       // velocity in domain-lengths per second
    vec3 nv = sampleVel(back);
    int i = idx * 4;
    vel2v[i] = nv.x; vel2v[i + 1] = nv.y; vel2v[i + 2] = nv.z;
}
#endif

#ifdef KERNEL_copyv
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= 4 * N3()) return;
    int N = gridn;
    int cidx = idx / 4;
    ivec3 c = cell3(cidx);
    float x = vel2v[idx];
    // closed box: kill the velocity component normal to a wall
    int comp = idx % 4;
    if ((comp == 0 && (c.x == 0 || c.x == N - 1)) ||
        (comp == 1 && (c.y == 0 || c.y == N - 1)) ||
        (comp == 2 && (c.z == 0 || c.z == N - 1))) x = 0.0;
    velv[idx] = x;
}
#endif

#ifdef KERNEL_divergence
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= N3()) return;
    ivec3 c = cell3(idx);
    float div = 0.5 * ((getVel(c + ivec3(1, 0, 0)).x - getVel(c - ivec3(1, 0, 0)).x) +
                       (getVel(c + ivec3(0, 1, 0)).y - getVel(c - ivec3(0, 1, 0)).y) +
                       (getVel(c + ivec3(0, 0, 1)).z - getVel(c - ivec3(0, 0, 1)).z));
    dye2v[idx * 2] = div;
    prsv[idx * 2] = 0.0;                                       // start the Jacobi solve from zero each frame
}
#endif

#ifdef KERNEL_jacobi
// p_new = (sum of 6 neighbours - div) / 6 (grid spacing 1).  Even sweeps read prs and write prs2, odd sweeps the reverse;
// the pass is repeated 2*iters times so the final result is back in prs.
float pget(bool fwd, int i) { return fwd ? prsv[i] : prs2v[i]; }
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= N3()) return;
    bool fwd = (REPEATINDEX & 1) == 0;
    ivec3 c = cell3(idx);
    float s = pget(fwd, cid(c + ivec3(1, 0, 0)) * 2) + pget(fwd, cid(c - ivec3(1, 0, 0)) * 2) +
              pget(fwd, cid(c + ivec3(0, 1, 0)) * 2) + pget(fwd, cid(c - ivec3(0, 1, 0)) * 2) +
              pget(fwd, cid(c + ivec3(0, 0, 1)) * 2) + pget(fwd, cid(c - ivec3(0, 0, 1)) * 2);
    float pn = (s - dye2v[idx * 2]) / 6.0;
    if (fwd) prs2v[idx * 2] = pn; else prsv[idx * 2] = pn;
}
#endif

#ifdef KERNEL_project
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= N3()) return;
    ivec3 c = cell3(idx);
    vec3 g = 0.5 * vec3(prsv[cid(c + ivec3(1, 0, 0)) * 2] - prsv[cid(c - ivec3(1, 0, 0)) * 2],
                        prsv[cid(c + ivec3(0, 1, 0)) * 2] - prsv[cid(c - ivec3(0, 1, 0)) * 2],
                        prsv[cid(c + ivec3(0, 0, 1)) * 2] - prsv[cid(c - ivec3(0, 0, 1)) * 2]);
    vec3 v = getVel(c) - g;
    int i = idx * 4;
    velv[i] = v.x; velv[i + 1] = v.y; velv[i + 2] = v.z;
}
#endif

#ifdef KERNEL_advectd
float dyeAt(ivec3 c, int comp) { return dyev[cid(c) * 2 + comp]; }
vec2 sampleDye(vec3 g) {
    g -= 0.5;
    ivec3 b = ivec3(floor(g));
    vec3 f = g - vec3(b);
    vec2 r = vec2(0.0);
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y) * (o.z == 1 ? f.z : 1.0 - f.z);
        r += w * vec2(dyeAt(b + o, 0), dyeAt(b + o, 1));
    }
    return r;
}
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= N3()) return;
    ivec3 c = cell3(idx);
    vec3 v = getVel(c);
    vec3 back = vec3(c) + 0.5 - v * dt() * float(gridn);
    vec2 d = sampleDye(back);
    dye2v[idx * 2] = d.x;
    dye2v[idx * 2 + 1] = d.y;
}
#endif

#ifdef KERNEL_copyd
void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= 2 * N3()) return;
    dyev[idx] = dye2v[idx];
}
#endif

#ifdef KERNEL_render
vec3 rotY(vec3 v, float a) { float c = cos(a), s = sin(a); return vec3(c * v.x + s * v.z, v.y, -s * v.x + c * v.z); }
vec3 rotX(vec3 v, float a) { float c = cos(a), s = sin(a); return vec3(v.x, c * v.y - s * v.z, s * v.y + c * v.z); }

vec2 dyeFetch(ivec3 c) {
    int i = cid(c) * 2;
    return vec2(dyev[i], dyev[i + 1]);
}
vec2 dyeSample(vec3 g) {                                       // g in grid units
    g -= 0.5;
    ivec3 b = ivec3(floor(g));
    vec3 f = g - vec3(b);
    vec2 a = mix(mix(dyeFetch(b), dyeFetch(b + ivec3(1, 0, 0)), f.x),
                 mix(dyeFetch(b + ivec3(0, 1, 0)), dyeFetch(b + ivec3(1, 1, 0)), f.x), f.y);
    vec2 bb = mix(mix(dyeFetch(b + ivec3(0, 0, 1)), dyeFetch(b + ivec3(1, 0, 1)), f.x),
                  mix(dyeFetch(b + ivec3(0, 1, 1)), dyeFetch(b + ivec3(1, 1, 1)), f.x), f.y);
    return mix(a, bb, f.z);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= TARGETSIZE.x || p.y >= TARGETSIZE.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(TARGETSIZE);
    float Nf = float(gridn);

    float az = radians(camangle + TIME * camspeed);
    float tl = radians(tilt);
    float camdist = 3.0 / zoom;
    vec2 ndc = uv * 2.0 - 1.0;
    float aspect = RENDERSIZE.x / RENDERSIZE.y;
    vec3 dv = normalize(vec3(ndc.x * aspect / 1.73, ndc.y / 1.73, 1.0));
    vec3 ro = rotY(rotX(vec3(0.0, 0.0, -camdist), -tl), -az);
    vec3 rd = rotY(rotX(dv, -tl), -az);

    // intersect the unit cube [-1,1]^3
    vec3 inv = 1.0 / (abs(rd) + 1e-6) * sign(rd + 1e-9);
    vec3 t0 = (vec3(-1.0) - ro) * inv;
    vec3 t1 = (vec3(1.0) - ro) * inv;
    vec3 tmn = min(t0, t1), tmx = max(t0, t1);
    float tin = max(max(tmn.x, tmn.y), max(tmn.z, 0.0));
    float tout = min(tmx.x, min(tmx.y, tmx.z));

    vec3 bg = mix(vec3(0.015, 0.015, 0.03), vec3(0.05, 0.05, 0.09), uv.y);
    vec3 acc = vec3(0.0);
    float trans = 1.0;

    if (tout > tin) {
        int steps = quality;
        float dts = (tout - tin) / float(steps);
        float jitter = cg_rand(uint(p.x) * 1973u + uint(p.y) * 9277u + uint(FRAMEINDEX) * 26699u);
        float t = tin + dts * jitter;
        float sigma = density * 0.6;
        for (int i = 0; i < steps; i++) {
            vec3 wp = ro + rd * t;
            vec3 g = (wp * 0.5 + 0.5) * Nf;
            vec2 s = dyeSample(g);
            float d = s.x;
            if (d > 0.002) {
                float a = 1.0 - exp(-d * sigma * dts * 6.0);
                // temperature drives the colour, density its brightness; hot smoke glows
                float tt = clamp(s.y * 0.6 + d * 0.08, 0.0, 1.0);
                vec3 c = cg_palette(palette, 0.1 + 0.9 * tt) * (0.35 + glow * s.y);
                acc += trans * a * c;
                trans *= 1.0 - a;
                if (trans < 0.02) break;
            }
            t += dts;
        }
    }
    vec3 col = acc;
    col = 1.0 - exp(-col * 1.6);
    float alpha = 1.0 - trans;
    if (transparent == 0) col += bg * trans;
    col = cg_hue(col, hueshift);
    imageStore(outimg, p, vec4(col, transparent != 0 ? alpha : 1.0));
}
#endif
