// Gray-Scott: state.r = chemical A (U), state.g = chemical B (V).  Karl Sims' 3x3 Laplacian, dt = 1.

#ifdef KERNEL_init
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= TARGETSIZE.x || p.y >= TARGETSIZE.y) return;
    vec2 sz = vec2(TARGETSIZE);
    float b = 0.0;
    uint s = uint(seed) * 7919u + 11u;
    if (seedpattern == 1) {
        b = distance(vec2(p), sz * 0.5) < 0.04 * min(sz.x, sz.y) ? 1.0 : 0.0;
    } else if (seedpattern == 2) {
        b = cg_rand(uint(p.x) * 1973u + uint(p.y) * 9277u + s) > 0.985 ? 1.0 : 0.0;
    } else {
        for (uint k = 0u; k < 12u; k++) {
            vec2 c = vec2(cg_rand(s + k * 3u), cg_rand(s + k * 3u + 1u)) * sz;
            float r = (0.01 + 0.03 * cg_rand(s + k * 3u + 2u)) * min(sz.x, sz.y);
            if (distance(vec2(p), c) < r) b = 1.0;
        }
    }
    imageStore(state, p, vec4(1.0, b, 0.0, 0.0));
}
#endif

#ifdef KERNEL_step
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= TARGETSIZE.x || p.y >= TARGETSIZE.y) return;
    vec2 px = 1.0 / vec2(TARGETSIZE);
    vec2 uv = (vec2(p) + 0.5) * px;

    vec2 c = texture(state_prev, uv).rg;
    vec2 lap = -c;
    lap += 0.2 * (texture(state_prev, uv + vec2(px.x, 0.0)).rg + texture(state_prev, uv - vec2(px.x, 0.0)).rg
                + texture(state_prev, uv + vec2(0.0, px.y)).rg + texture(state_prev, uv - vec2(0.0, px.y)).rg);
    lap += 0.05 * (texture(state_prev, uv + px).rg + texture(state_prev, uv - px).rg
                 + texture(state_prev, uv + vec2(px.x, -px.y)).rg + texture(state_prev, uv + vec2(-px.x, px.y)).rg);

    float F = feed;
    float K = kill;
    if (preset == 1) { F = 0.0545; K = 0.062; }
    else if (preset == 2) { F = 0.0367; K = 0.0649; }
    else if (preset == 3) { F = 0.029; K = 0.057; }
    else if (preset == 4) { F = 0.03; K = 0.06; }
    else if (preset == 5) { F = 0.078; K = 0.061; }

    float abb = c.x * c.y * c.y;
    float a = c.x + du * lap.x - abb + F * (1.0 - c.x);
    float b = c.y + dv * lap.y + abb - (F + K) * c.y;

    // splat: paint chemical B, once per click (first sub-step of the frame)
    if (splat != 0 && REPEATINDEX == 0) {
        float asp = float(TARGETSIZE.x) / float(TARGETSIZE.y);
        vec2 d = (uv - splatpos) * vec2(asp, 1.0);
        if (length(d) < splatsize) { b = 1.0; a = 0.5; }
    }
    imageStore(state, p, vec4(clamp(a, 0.0, 1.0), clamp(b, 0.0, 1.0), 0.0, 0.0));
}
#endif

#ifdef KERNEL_render
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= TARGETSIZE.x || p.y >= TARGETSIZE.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(TARGETSIZE);
    vec2 px = 1.0 / vec2(textureSize(state_prev, 0));
    float v = texture(state_prev, uv).g;
    float t = clamp(smoothstep(0.0, 0.42, v) * brightness, 0.0, 1.0);
    vec3 col = cg_palette(palette, t);

    // relief shading from the gradient of chemical B
    float hx = texture(state_prev, uv + vec2(px.x, 0.0)).g - texture(state_prev, uv - vec2(px.x, 0.0)).g;
    float hy = texture(state_prev, uv + vec2(0.0, px.y)).g - texture(state_prev, uv - vec2(0.0, px.y)).g;
    vec3 n = normalize(vec3(-hx * 6.0, -hy * 6.0, 1.0));
    float l = clamp(dot(n, normalize(vec3(-0.5, 0.6, 0.7))), 0.0, 1.0);
    col *= mix(1.0, 0.35 + 0.95 * l, shading);
    col += pow(l, 24.0) * 0.25 * shading * t;
    imageStore(outimg, p, vec4(cg_hue(col, hueshift), 1.0));
}
#endif
