// Physarum - agents (x, y, angle) in sim pixels; trail is a float field, deposits go through a fixed-point
// integer texture ("dep") so thousands of agents can add to one pixel atomically.

const float FIX = 4096.0;
const float TAU = 6.28318530718;

#ifdef BIND_agents
layout(std430, binding = BIND_agents) buffer AgentBuf { vec4 agents[]; };
#endif

#ifdef KERNEL_init
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(TARGETSIZE.x)) return;
    vec2 sz = RENDERSIZE / float(simscale);
    uint s = i * 4u + uint(seed) * 7919u + 13u;
    vec2 p;
    float a;
    if (initpattern == 1) {
        float t = cg_rand(s) * TAU;
        float r = 0.35 * min(sz.x, sz.y);
        p = sz * 0.5 + vec2(cos(t), sin(t)) * r;
        a = t + 3.14159265;                     // face inward
    } else if (initpattern == 2) {
        p = sz * 0.5 + (vec2(cg_rand(s), cg_rand(s + 1u)) - 0.5) * 24.0;
        a = cg_rand(s + 2u) * TAU;
    } else {
        p = vec2(cg_rand(s), cg_rand(s + 1u)) * sz;
        a = cg_rand(s + 2u) * TAU;
    }
    agents[i] = vec4(p, a, 0.0);
}
#endif

#ifdef KERNEL_move
float sense(vec2 p, float a, vec2 sz) {
    vec2 q = p + sensordist * vec2(cos(a), sin(a));
    return texture(trail_prev, q / sz).r;
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(TARGETSIZE.x)) return;
    vec4 ag = agents[i];
    vec2 p = ag.xy;
    float a = ag.z;
    vec2 sz = vec2(textureSize(trail_prev, 0));

    float fwd = sense(p, a, sz);
    float lft = sense(p, a + sensorangle, sz);
    float rgt = sense(p, a - sensorangle, sz);
    float rnd = cg_rand(i * 1664525u + uint(FRAMEINDEX) * 22695477u + 17u);
    float ts = turnspeed * TIMEDELTA;

    if (fwd > lft && fwd > rgt) {
        // straight on
    } else if (fwd < lft && fwd < rgt) {
        a += (rnd - 0.5) * 2.0 * ts;           // dead end: wander
    } else if (lft > rgt) {
        a += ts;
    } else if (rgt > lft) {
        a -= ts;
    }

    p += vec2(cos(a), sin(a)) * movespeed * TIMEDELTA;
    if (wrap != 0) {
        p = mod(p, sz);
    } else {
        if (p.x < 0.0 || p.x >= sz.x) { p.x = clamp(p.x, 0.0, sz.x - 1.0); a = 3.14159265 - a; }
        if (p.y < 0.0 || p.y >= sz.y) { p.y = clamp(p.y, 0.0, sz.y - 1.0); a = -a; }
    }
    agents[i] = vec4(p, a, 0.0);

    ivec2 ip = clamp(ivec2(p), ivec2(0), ivec2(sz) - 1);
    imageAtomicAdd(dep, ip, uint(deposit * FIX * TIMEDELTA * 60.0));
}
#endif

#ifdef KERNEL_diffuse
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= TARGETSIZE.x || p.y >= TARGETSIZE.y) return;
    vec2 px = 1.0 / vec2(TARGETSIZE);
    vec2 uv = (vec2(p) + 0.5) * px;
    float c = texture(trail_prev, uv).r;
    float s = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            s += texture(trail_prev, uv + vec2(x, y) * px).r;
        }
    }
    s /= 9.0;
    float v = mix(c, s, clamp(diffuse * TIMEDELTA * 60.0, 0.0, 1.0));
    v *= exp(-decay * TIMEDELTA);
    v += float(imageLoad(dep, p).r) / FIX;
    imageStore(trail, p, vec4(v));
    imageStore(dep, p, uvec4(0u));
}
#endif

#ifdef KERNEL_render
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= TARGETSIZE.x || p.y >= TARGETSIZE.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(TARGETSIZE);
    float v = texture(trail_prev, uv).r;
    float t = 1.0 - exp(-v * brightness * 0.02);
    vec3 col = cg_hue(cg_palette(palette, t), hueshift);
    imageStore(outimg, p, vec4(col, 1.0));
}
#endif
