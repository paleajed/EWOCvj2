{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-nvfp4-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "Load Text Encoder"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Load VAE"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "${PROMPT}"
    },
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "${NEGATIVE_PROMPT}"
    },
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "6": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["4", 0],
      "negative": ["5", 0],
      "frame_rate": "${FPS}"
    },
    "_meta": {
      "title": "Tag Conditioning With Frame Rate"
    }
  },
  "7": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": "${WIDTH}",
      "height": "${HEIGHT}",
      "length": "${FRAMES}",
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty Video Latent"
    }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "${SEED}"
    },
    "_meta": {
      "title": "Random Noise"
    }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    },
    "_meta": {
      "title": "Select Sampler"
    }
  },
  "10": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    },
    "_meta": {
      "title": "Distilled Sigma Schedule (8 steps)"
    }
  },
  "11": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["20", 0],
      "positive": ["22", 0],
      "negative": ["22", 1],
      "cfg": 1.0
    },
    "_meta": {
      "title": "CFG Guidance (distilled, cfg=1)"
    }
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["11", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["22", 2]
    },
    "_meta": {
      "title": "Generate (Diffusion Sampling)"
    }
  },
  "13": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["23", 2],
      "vae": ["3", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "_meta": {
      "title": "Decode Video (Tiled VAE)"
    }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["13", 0],
      "fps": "${FPS}"
    },
    "_meta": {
      "title": "Assemble Video"
    }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "ltx_nvfp4_cutout_guides/${BATCH_ID}/video",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save Video"
    }
  },
  "20": {
    "class_type": "LTXICLoRALoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "TTM_IC-lora_ltx2.3.safetensors",
      "strength_model": 2.0
    },
    "_meta": {
      "title": "Load Cutout Guides LoRA"
    }
  },
  "21": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "${INPUT_IMAGE}",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": "${FRAMES}",
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "AnimateDiff"
    },
    "_meta": {
      "title": "Load Reference Cutout Video"
    }
  },
  "22": {
    "class_type": "LTXAddVideoICLoRAGuideAdvanced",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["6", 1],
      "vae": ["3", 0],
      "latent": ["7", 0],
      "image": ["21", 0],
      "frame_idx": 0,
      "strength": 1.0,
      "attention_strength": 1.0,
      "latent_downscale_factor": ["20", 1],
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64
    },
    "_meta": {
      "title": "Cutout Guide"
    }
  },
  "23": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": ["22", 0],
      "negative": ["22", 1],
      "latent": ["12", 0]
    },
    "_meta": {
      "title": "Strip Guide Keyframe Before Decode"
    }
  }
}
