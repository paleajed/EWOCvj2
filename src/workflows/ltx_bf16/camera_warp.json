{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-dev-transformer-bf16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-bf16.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "Load Text Encoder"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Load VAE"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "crossview. ${PROMPT}"
    },
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "${NEGATIVE_PROMPT}"
    },
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "6": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["4", 0],
      "negative": ["5", 0],
      "frame_rate": "${FPS}"
    },
    "_meta": {
      "title": "Tag Conditioning With Frame Rate"
    }
  },
  "7": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": "${WIDTH}",
      "height": "${HEIGHT}",
      "length": "${FRAMES}",
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty Video Latent"
    }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "${SEED}"
    },
    "_meta": {
      "title": "Random Noise"
    }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    },
    "_meta": {
      "title": "Select Sampler"
    }
  },
  "10": {
    "class_type": "ModelSamplingLTXV",
    "inputs": {
      "model": ["20", 0],
      "max_shift": 2.05,
      "base_shift": 0.95,
      "latent": ["7", 0]
    },
    "_meta": {
      "title": "Configure Sampler Shift"
    }
  },
  "11": {
    "class_type": "LTXVScheduler",
    "inputs": {
      "steps": "${STEPS}",
      "max_shift": 2.05,
      "base_shift": 0.95,
      "stretch": true,
      "terminal": 0.1,
      "latent": ["7", 0]
    },
    "_meta": {
      "title": "Create Noise Schedule"
    }
  },
  "12": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["10", 0],
      "positive": ["26", 0],
      "negative": ["26", 1],
      "cfg": "${CFG_SCALE}"
    },
    "_meta": {
      "title": "CFG Guidance"
    }
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["12", 0],
      "sampler": ["9", 0],
      "sigmas": ["11", 0],
      "latent_image": ["26", 2]
    },
    "_meta": {
      "title": "Generate (Diffusion Sampling)"
    }
  },
  "14": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["27", 2],
      "vae": ["3", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "_meta": {
      "title": "Decode Video (Tiled VAE)"
    }
  },
  "15": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["14", 0],
      "fps": "${FPS}"
    },
    "_meta": {
      "title": "Assemble Video"
    }
  },
  "16": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["15", 0],
      "filename_prefix": "ltx_bf16_camera_warp/${BATCH_ID}/video",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save Video"
    }
  },
  "20": {
    "class_type": "LTXICLoRALoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "LTX2.3-22B_IC-LoRA-CrossView-Warp_v2_6000.safetensors",
      "strength_model": 2.0
    },
    "_meta": {
      "title": "Load Camera Warp LoRA"
    }
  },
  "21": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "${INPUT_IMAGE}",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": "${FRAMES}",
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "AnimateDiff"
    },
    "_meta": {
      "title": "Load Input Video"
    }
  },
  "22": {
    "class_type": "LoadMoGeModel",
    "inputs": {
      "model_name": "moge_2_vitl_normal_fp16.safetensors"
    },
    "_meta": {
      "title": "MoGe Model"
    }
  },
  "23": {
    "class_type": "MoGeInference",
    "inputs": {
      "moge_model": ["22", 0],
      "image": ["21", 0],
      "resolution_level": 2,
      "fov_x_degrees": 0,
      "batch_size": 4,
      "force_projection": true,
      "apply_mask": true
    },
    "_meta": {
      "title": "MoGe Geometry"
    }
  },
  "24": {
    "class_type": "CrossViewWarp",
    "inputs": {
      "frames": ["21", 0],
      "moge_geometry": ["23", 0],
      "azimuth": 0,
      "elevation": 0,
      "distance": 1,
      "hfov": 50,
      "vertical_shift": 0,
      "depth_ratio": 6,
      "smooth_depth": false,
      "invert_depth": false,
      "roll_lock": true,
      "pivot_override": true,
      "pivot_x": 0,
      "pivot_y": 0,
      "pivot_z": 1.05,
      "use_keyframes": false,
      "frame_count": 0,
      "keyframes": "",
      "interp_motion": "linear",
      "interpolation": "linear",
      "keep_source_aim": false,
      "preview_size": 512,
      "frame_index": 1
    },
    "_meta": {
      "title": "Camera Warp - NOTE: static identity-pose placeholder, no live UI drives azimuth/elevation/distance/pivot/keyframes yet (this preset is not registered - see PresetType's comment)"
    }
  },
  "25": {
    "class_type": "LTXAddVideoICLoRAGuideAdvanced",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["6", 1],
      "vae": ["3", 0],
      "latent": ["7", 0],
      "image": ["24", 0],
      "frame_idx": 0,
      "strength": 1.0,
      "attention_strength": 1.0,
      "latent_downscale_factor": ["20", 1],
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64
    },
    "_meta": {
      "title": "Camera Warp Guide"
    }
  },
  "26": {
    "class_type": "LTXAddVideoICLoRAGuideAdvanced",
    "inputs": {
      "positive": ["25", 0],
      "negative": ["25", 1],
      "vae": ["3", 0],
      "latent": ["25", 2],
      "image": ["21", 0],
      "frame_idx": 0,
      "strength": 1.0,
      "attention_strength": 1.0,
      "latent_downscale_factor": ["20", 1],
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64
    },
    "_meta": {
      "title": "Camera Source Guide"
    }
  },
  "27": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": ["26", 0],
      "negative": ["26", 1],
      "latent": ["13", 0]
    },
    "_meta": {
      "title": "Strip Guide Keyframes Before Decode"
    }
  }
}
