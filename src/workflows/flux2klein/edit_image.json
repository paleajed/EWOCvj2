{
  "10": {
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" }
  },
  "11": {
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "flux2"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "CLIP Loader (Qwen3 4B)" }
  },
  "12": {
    "inputs": {
      "unet_name": "flux-2-klein-4b-Q4_K_S.gguf"
    },
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "Load Diffusion Model" }
  },
  "14": {
    "inputs": {
      "text": "${PROMPT}",
      "clip": ["11", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Edit Instruction)" }
  },
  "15": {
    "inputs": {
      "conditioning": ["14", 0],
      "guidance": 1.0
    },
    "class_type": "FluxGuidance",
    "_meta": { "title": "Flux Guidance" }
  },
  "16": {
    "inputs": {
      "conditioning": ["14", 0]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Zero Negative Conditioning" }
  },
  "30": {
    "inputs": {
      "image": "${INPUT_IMAGE}"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Input Image" }
  },
  "33": {
    "inputs": {
      "image": ["30", 0],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 1
    },
    "class_type": "ImageScaleToTotalPixels",
    "_meta": { "title": "Fit Input To 1MP" }
  },
  "34": {
    "inputs": {
      "image": ["33", 0]
    },
    "class_type": "GetImageSize",
    "_meta": { "title": "Get Canvas Size" }
  },
  "35": {
    "inputs": {
      "width": ["34", 0],
      "height": ["34", 1],
      "batch_size": 1
    },
    "class_type": "EmptyFlux2LatentImage",
    "_meta": { "title": "Empty Latent (matches input size)" }
  },
  "52": {
    "inputs": {
      "conditioning": ["15", 0],
      "vae": ["10", 0],
      "image_1": ["33", 0],
      "max_megapixels": 1.0,
      "mask_fill_mode": "pixel_grey",
      "image1_strength": 1.0,
      "image1_start_percent": 0.0,
      "image1_end_percent": 1.0,
      "image1_face": false,
      "image1_background": false
    },
    "class_type": "ReferenceLatentPlus",
    "_meta": { "title": "Reference Latent+ (Edit Target)" }
  },
  "18": {
    "inputs": {
      "seed": "${SEED}",
      "steps": "${STEPS}",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["12", 0],
      "positive": ["52", 0],
      "negative": ["16", 0],
      "latent_image": ["35", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" }
  },
  "19": {
    "inputs": {
      "samples": ["18", 0],
      "vae": ["10", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "20": {
    "inputs": {
      "filename_prefix": "flux2klein_edit/${BATCH_ID}/image",
      "images": ["19", 0]
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
